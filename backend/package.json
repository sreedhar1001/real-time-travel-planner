{
  "name": "real-time-travel-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/event-worker.ts",
    "dev:weather": "tsx watch src/weather-worker.ts",
    "dev:flight": "tsx watch src/flight-worker.ts",
    "publish:fixture": "tsx src/publish-fixture.ts",
    "publish:flight-fixture": "tsx src/publish-flight-fixture.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/event-worker.js",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
