PORT=3000
DATABASE_URL=postgres://travel:change-me@localhost:5432/travel
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
EVENT_STREAM=travel:events:v1
EVENT_GROUP=replanner
EVENT_RECLAIM_IDLE_MS=60000
WEATHER_TRIP_ID=00000000-0000-4000-8000-000000000002
WEATHER_LATITUDE=35.6762
WEATHER_LONGITUDE=139.6503
WEATHER_POLL_INTERVAL_MS=1800000
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# For a subscribed commercial endpoint, use customer-api.open-meteo.com and set its key.
WEATHER_API_KEY=
FLIGHT_INPUT_STREAM=travel:flight-status:inbox:v1
FLIGHT_EVENT_GROUP=flight-normalizer
FLIGHT_DELAY_THRESHOLD_MINUTES=15
